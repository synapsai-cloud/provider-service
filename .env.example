# Provider service. Copy to .env. This process is the one that reads these values.

# Shared secret. Callers send it as Authorization: Bearer.
PROVIDER_SERVICE_TOKEN=
PROVIDER_SERVICE_HOST=127.0.0.1
PROVIDER_SERVICE_PORT=8091

# Fallback when a caller does not name a backend. Callers name the backend on
# each request. This value is used by the service's own helpers.
# INFERENCE_BACKEND=inferx

# Registry credentials used when the caller sends a private image tag.
# GHCR_INFERENCE_IMAGE_USERNAME=
# GHCR_INFERENCE_IMAGE_READ_TOKEN=

# InferX (https://model.inferx.net)
# INFERX_BASE_URL=https://model.inferx.net
# INFERX_API_KEY=ix_...
# INFERX_SESSION=.eJz...
# INFERX_TENANT=tn-...

# Modal. The SDK token pair is separate from the proxy token that authenticates
# inference requests.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# MODAL_PROXY_TOKEN_ID=
# MODAL_PROXY_TOKEN_SECRET=
# MODAL_SERVER_UNAUTHENTICATED=0
# MODAL_GPU=
# MODAL_ENVIRONMENT=
# MODAL_STARTUP_TIMEOUT=1800

# Runpod load-balancing serverless endpoint. Private ghcr.io pulls reuse the
# GHCR username and read token above.
# RUNPOD_API_KEY=
# RUNPOD_API_BASE=https://api.runpod.io
# RUNPOD_GPU_POOL=
# RUNPOD_DISK_GB=80
# RUNPOD_TARGET_CONCURRENCY=
# RUNPOD_EXECUTION_TIMEOUT_MS=1800000

# Beam Pods. Private ghcr.io pulls are written into the Beam workspace as
# GITHUB_USERNAME and GITHUB_TOKEN.
# BEAM_TOKEN=
# BEAM_GPU=
# BEAM_ONDEMAND_GPU=
# BEAM_POD_CPU=4
# BEAM_POD_MEMORY=
# BEAM_TARGET_CONCURRENCY=
# BEAM_KEEP_WARM_SECONDS=300
# BEAM_CHECKPOINT_ENABLED=1
# BEAM_CHECKPOINT_TIMEOUT=900
# BEAM_SERVER_UNAUTHENTICATED=0
# BEAM_ONDEMAND_ONLY=0
# 1 reserves max_instances on-demand machines and does not deploy a serverless Pod.
# SYNAPS_EDGE_TOKEN is not read here. The edge header is an HMAC of BEAM_TOKEN.

# Custom-image gate inside the Beam pod.
# The gate program reads these inside the container. They are not service settings.
